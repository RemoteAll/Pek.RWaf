{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "接续自检（打开项目自动运行）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"tools/continuity/install-global-instruction.ps1"
			],
			"runOptions": {
				"runOn": "folderOpen"
			}
		},
		{
			"label": "编译检查（cargo check）",
			"type": "shell",
			"command": "cargo",
			"args": [
				"check"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		},
		{
			"label": "构建（cargo build --profile fast）",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build",
				"--profile",
				"fast"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$rustc"
			]
		},
		{
			"label": "测试（cargo test）",
			"type": "shell",
			"command": "cargo",
			"args": [
				"test"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$rustc"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			}
		}
	]
}
